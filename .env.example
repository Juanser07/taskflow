# Copia este archivo como .env y ajusta los valores:  cp .env.example .env

# --- Base de datos (contenedor db) ---
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow_pass

# --- API (contenedor api) ---
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRE_MINUTES=120
# Carga usuarios, proyecto y tareas de ejemplo la primera vez que arranca
SEED_DATA=true

# --- Web (contenedor web) ---
WEB_PORT=8080
